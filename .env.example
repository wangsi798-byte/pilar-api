# ── MongoDB Atlas ──────────────────────────────
# Dapatkan di: https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@cluster.xxxxx.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://pilaruser:GANTI_PASSWORD@cluster0.xxxxx.mongodb.net/pilar?retryWrites=true&w=majority

# ── JWT Secret ─────────────────────────────────
# Buat string acak panjang, misal: openssl rand -hex 64
JWT_SECRET=ganti_dengan_string_acak_sangat_panjang_dan_rahasia
JWT_EXPIRES_IN=7d

# ── Server ─────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS — URL frontend Anda ───────────────────
# Development
CLIENT_URL=http://localhost:3000
# Production (ganti dengan URL Vercel Anda)
# CLIENT_URL=https://pilar.vercel.app
